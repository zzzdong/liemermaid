WHITESPACE = _{ " " | "\t" }
NEWLINE = { "\r\n" | "\n" | "\r" }
COMMENT = _{ "%%" ~ (!NEWLINE ~ ANY)* ~ NEWLINE }

simple_id = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
quoted_id = { "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
identifier = { quoted_id | simple_id }

free_text = { (!NEWLINE ~ ANY)* }
edge_label = { (!"|" ~ ANY)* }
subgraph_title = { (!NEWLINE ~ ANY)* }
text = { identifier | quoted_id }

direction = { "TB" | "TD" | "BT" | "RL" | "LR" }
node_shape_brackets = { "[" ~ node_text ~ "]" }
node_shape_parens = { "(" ~ node_text ~ ")" }
node_shape_circle = { "((" ~ node_text ~ "))" }
node_shape_double_circle = { "(((" ~ node_text ~ ")))" }
node_shape_stadium = { "([" ~ node_text ~ "])" }
node_shape_database = { "[(" ~ node_text ~ ")]" }
node_shape_subroutine = { "[[" ~ node_text ~ "]]" }
node_shape_diamond = { "{" ~ node_text ~ "}" }
node_shape_hexagon = { "{{" ~ node_text ~ "}}" }
node_shape_asymmetric = { ">" ~ node_text ~ "]" }
node_shape_parallelogram = { "[/" ~ node_text ~ "/]" }
node_shape_parallelogram_alt = { "[\\" ~ node_text ~ "\\]" }
node_shape_trapezoid = { "[/" ~ node_text ~ "\\]" }
node_shape_trapezoid_alt = { "[\\" ~ node_text ~ "/]" }
node_shape = { node_shape_double_circle | node_shape_circle | node_shape_stadium | node_shape_parens | node_shape_database | node_shape_subroutine | node_shape_parallelogram | node_shape_trapezoid | node_shape_parallelogram_alt | node_shape_trapezoid_alt | node_shape_brackets | node_shape_diamond | node_shape_hexagon | node_shape_asymmetric }
node_text = { text }
node_decl = { identifier ~ (node_shape)? }

edge_text_solid = @{ (!("-->" | NEWLINE) ~ ANY)* }
edge_text_thick = @{ (!("==>" | NEWLINE) ~ ANY)* }
edge_text_dotted = @{ (!(".->" | NEWLINE) ~ ANY)* }
edge_arrow_solid = { "-->" }
edge_arrow_dotted = { "-.->" }
edge_arrow_thick = { "==>" }
edge_arrow_no_arrow = { "---" }
edge_arrow_circle = { "--o" }
edge_arrow_cross = { "--x" }
edge_arrow_both = { "<-->" }
edge_arrow_invisible = { "~~~" }
edge_arrow_multi_circle = { "o--o" }
edge_arrow_multi_cross = { "x--x" }
edge_arrow_labeled = { "-->|" ~ edge_label ~ "|" }
edge_arrow_solid_text = { "--" ~ edge_text_solid ~ "-->" }
edge_arrow_thick_text = { "==" ~ edge_text_thick ~ "==>" }
edge_arrow_dotted_text = { "-." ~ edge_text_dotted ~ ".->" }
edge_arrow = { edge_arrow_labeled | edge_arrow_solid | edge_arrow_no_arrow | edge_arrow_circle | edge_arrow_cross | edge_arrow_dotted | edge_arrow_thick | edge_arrow_solid_text | edge_arrow_thick_text | edge_arrow_dotted_text | edge_arrow_both | edge_arrow_invisible | edge_arrow_multi_circle | edge_arrow_multi_cross }
edge = { identifier ~ (edge_arrow ~ identifier)+ }

subgraph = { "subgraph" ~ subgraph_title? ~ NEWLINE+ ~ (subgraph_stmt ~ (NEWLINE+ ~ subgraph_stmt)*)? ~ NEWLINE* ~ "end" }
subgraph_stmt = _{ edge | subgraph | (!"end" ~ node_decl) }
flowchart_statement = { edge | subgraph | node_decl }
flowchart_diagram = { ("flowchart" | "graph") ~ direction? ~ NEWLINE+ ~ (flowchart_statement ~ (NEWLINE+ ~ flowchart_statement)*)? }

participant_kind = { "participant" | "actor" | "boundary" | "control" | "entity" | "database" | "collections" | "queue" }
participant = { participant_kind ~ identifier ~ ("as" ~ identifier)? }
message_arrow_solid = { "->" }
message_arrow_solid_tip = { "->>" }
message_arrow_dashed = { "-->" }
message_arrow_dashed_tip = { "-->>" }
message_arrow_cross = { "-x" }
message_arrow_open = { "-)" }
message_arrow_both_solid = { "<<->>" }
message_arrow_both_dashed = { "<<-->>" }
message_arrow_dashed_cross = { "--x" }
message_arrow_dashed_open = { "--)" }
message_arrow = { message_arrow_both_solid | message_arrow_both_dashed | message_arrow_open | message_arrow_dashed_open | message_arrow_cross | message_arrow_dashed_cross | message_arrow_dashed_tip | message_arrow_dashed | message_arrow_solid_tip | message_arrow_solid }
message_activation = { "+" | "-" }
message = { identifier ~ message_arrow ~ message_activation? ~ identifier ~ (":" ~ free_text)? }
note_placement = { ("left" | "right") ~ "of" | "over" }
note_target = { identifier ~ ("," ~ identifier)? }
note = { "note" ~ note_placement ~ note_target ~ ":" ~ free_text }
activation = { ("+" | "-") ~ identifier }
seq_block_label = { (!NEWLINE ~ ANY)* }
seq_block_stmt = _{ sequence_statement | seq_block }
seq_alt_branch = { seq_block_label? ~ NEWLINE+ ~ (seq_block_stmt ~ (NEWLINE+ ~ seq_block_stmt)*)? }
loop_block = { "loop" ~ seq_block_label? ~ NEWLINE+ ~ (seq_block_stmt ~ (NEWLINE+ ~ seq_block_stmt)*)? ~ NEWLINE* ~ "end" }
alt_block = { "alt" ~ seq_alt_branch ~ (NEWLINE* ~ "else" ~ seq_alt_branch)* ~ NEWLINE* ~ "end" }
opt_block = { "opt" ~ seq_block_label? ~ NEWLINE+ ~ (seq_block_stmt ~ (NEWLINE+ ~ seq_block_stmt)*)? ~ NEWLINE* ~ "end" }
par_block = { "par" ~ seq_alt_branch ~ (NEWLINE* ~ "and" ~ seq_alt_branch)* ~ NEWLINE* ~ "end" }
seq_block = { loop_block | alt_block | opt_block | par_block }
sequence_statement = { participant | message | note | activation | seq_block }
sequence_diagram = { "sequenceDiagram" ~ NEWLINE+ ~ (sequence_statement ~ (NEWLINE+ ~ sequence_statement)*)? ~ NEWLINE* }

visibility = { "+" | "-" | "#" | "~" }
class_generic = { "~" ~ (!"~" ~ ANY)* ~ "~" }
class_type = { identifier ~ class_generic? }
class_member_colon = { identifier ~ ":" ~ class_type }
class_member_plain = { identifier ~ identifier? ~ ("(" ~ ")")? ~ class_type? }
class_member = { visibility? ~ (class_member_colon | class_member_plain) }
class_members = { "{" ~ NEWLINE* ~ (class_member ~ (NEWLINE+ ~ class_member)*)? ~ NEWLINE* ~ "}" }
class_annotation = { "<<" ~ (!(">>") ~ ANY)* ~ ">>" }
class_keyword = @{ "class" ~ !(ASCII_ALPHANUMERIC | "_") }
class_decl = { class_keyword ~ identifier ~ class_generic? ~ class_annotation? ~ class_members? }
class_member_decl = { identifier ~ ":" ~ identifier }
relation_type = { "<|--" | "*--" | "o--" | "-->" | "..>" }
relation_cardinality = { quoted_id }
relation_label = { ":" ~ free_text }
relation = { identifier ~ relation_cardinality? ~ relation_type ~ relation_cardinality? ~ identifier ~ relation_label? }
class_diagram = { "classDiagram" ~ NEWLINE+ ~ (class_decl | class_member_decl | relation) ~ (NEWLINE+ ~ (class_decl | class_member_decl | relation))* ~ NEWLINE* }

state_id = { identifier }
state_simple = { "state" ~ (quoted_id ~ "as" ~ state_id | state_id ~ (":" ~ free_text)?) }
state_composite = { "state" ~ state_id ~ "{" ~ NEWLINE* ~ (state_element ~ (NEWLINE+ ~ state_element)*)? ~ NEWLINE* ~ "}" }
state_bare = { state_id ~ (":" ~ free_text)? }
state_element = _{ state_simple | transition | state_composite | state_bare }
start_end_state = { "[*]" }
transition = { (state_id | start_end_state) ~ "-->" ~ (state_id | start_end_state) ~ (":" ~ free_text)? }
state_diagram = { ("stateDiagram-v2" | "stateDiagram") ~ NEWLINE+ ~ (state_element ~ (NEWLINE+ ~ state_element)*)? ~ NEWLINE* }

cardinality = { "|o" | "||" | "}o" | "}|" | "o|" | "o{" | "|{" }
relationship = { cardinality ~ "--" ~ cardinality }
attribute = { identifier ~ identifier }
entity_attributes = { "{" ~ NEWLINE* ~ (attribute ~ ("," ~ attribute)*)? ~ NEWLINE* ~ "}" }
entity = { identifier ~ entity_attributes? }
er_relationship_label = { ":" ~ free_text }
er_statement = { identifier ~ relationship ~ identifier ~ er_relationship_label? }
er_element = _{ er_statement | entity }
er_diagram = { "erDiagram" ~ NEWLINE+ ~ (er_element ~ (NEWLINE+ ~ er_element)*)? ~ NEWLINE* }

pie_showdata = { "showData" }
pie_diagram = { "pie" ~ pie_showdata? ~ (NEWLINE ~ pie_modifier)* ~ NEWLINE+ ~ (pie_data_entry ~ (NEWLINE+ ~ pie_data_entry)*)* ~ NEWLINE* }
pie_modifier = { "title" ~ free_text | "showData" }
pie_data_entry = ${ (!(":" | NEWLINE) ~ ANY)+ ~ ":" ~ (!NEWLINE ~ ANY)* }

timeline_direction = { "TD" | "LR" }
timeline_diagram = { "timeline" ~ timeline_direction? ~ NEWLINE+ ~ (timeline_entry ~ (NEWLINE+ ~ timeline_entry)*)* ~ NEWLINE* }
timeline_entry = _{ tl_title | tl_section | tl_event_line }
tl_title = { ^"title" ~ free_text }
tl_section = { "section" ~ free_text }
tl_event_line = ${ (!(":" | NEWLINE) ~ ANY)+ ~ ":" ~ (!NEWLINE ~ ANY)* }

gg_direction = { "LR" | "TB" | "BT" }
gg_attr_key = { "id" | "type" | "tag" | "parent" }
gg_attr_value = { (!(gg_attr_key ~ ":") ~ !NEWLINE ~ ANY)* }
gg_attr = { gg_attr_key ~ ":" ~ gg_attr_value }
gg_commit = { "commit" ~ (gg_attr ~ (","? ~ gg_attr)*)? }
gg_branch = { "branch" ~ identifier }
gg_checkout = { ("checkout" | "switch") ~ identifier }
gg_merge = { "merge" ~ identifier ~ (gg_attr ~ (","? ~ gg_attr)*)? }
gg_cherry_pick = { "cherry-pick" ~ (gg_attr ~ (","? ~ gg_attr)*)? }
gg_statement = { gg_commit | gg_branch | gg_checkout | gg_merge | gg_cherry_pick }
gg_diagram = { "gitGraph" ~ (gg_direction ~ ":")? ~ NEWLINE+ ~ (gg_statement ~ (NEWLINE+ ~ gg_statement)*)* ~ NEWLINE* }

file = { SOI ~ (COMMENT | WHITESPACE | NEWLINE)* ~ (flowchart_diagram | sequence_diagram | class_diagram | state_diagram | er_diagram | pie_diagram | timeline_diagram | gg_diagram) ~ (COMMENT | WHITESPACE | NEWLINE)* ~ EOI }